{
  "name": "raytok-site",
  "version": "1.0.5",
  "description": "RayTok static website and local server mockup",
  "scripts": {
    "test:relay": "npm --prefix relay run test:limits",
    "test:host": "node -e \"try { require('ws'); } catch(e) { console.error('[FAIL] Cannot find module ws. Please run npm ci first.'); process.exit(1); }\" && node samples/host_view_test.js && node samples/w_t_test.js",
    "test:wire": "node samples/wire_script_test.js",
    "test:end": "node samples/end_test.js",
    "test:report": "node samples/report_common_test.js",
    "test:script": "npm --prefix relay run test:script",
    "test:wire": "node samples/wire_script_test.js",
    "test:mint": "npm --prefix relay run test:mint",
    "test:lic": "node samples/lic_page_test.js",
    "mail": "node scripts/mailcheck.js --force",
    "test:hwpx": "node samples/hwpx_test.js",
    "test:desk-view": "node samples/desk_view_test.js",
    "test:dual": "npm --prefix relay run test:dual",
    "test:terms": "node samples/terms_test.js",
    "test:guide": "node samples/guide_test.js",
    "test:usage": "node samples/usage_view_test.js",
    "test:p16": "node relay/test/p16-lock.mjs",
    "test:design": "node samples/design_theme_test.js",
    "test:release": "node samples/release_e2e_test.js",
    "test:retention": "node relay/test/desk-retention.mjs",
    "test:w-t": "node samples/w_t_test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^3.11.174",
    "playwright": "1.63.0"
  }
}
